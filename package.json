{
  "name": "quark.autobutler.org",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-updates": "ncu -u",
    "lint:eslint": "eslint .",
    "lint:types": "vue-tsc --build",
    "lint:prettier": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\"",
    "lint": "concurrently -m1 npm:lint:*",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "fix:md": "markdownlint-cli2 --fix \"**/*.md\" \"!node_modules/**\"",
    "fix": "concurrently -m1 npm:fix:*"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "npm-check-updates": "^23.0.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
